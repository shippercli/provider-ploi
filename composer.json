{
    "name": "shippercli/provider-ploi",
    "description": "Ploi provider plugin for Shipper CLI",
    "type": "shipper-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ploi/ploi-php-sdk": "^1.9",
        "shippercli/contracts": "^1.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "ShipperCli\\ProviderPloi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ShipperCli\\ProviderPloi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php vendor/bin/pest --no-coverage"
    },
    "extra": {
        "shipper-plugin": "ShipperCli\\ProviderPloi\\PloiPlugin"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "vendor",
            "node_modules",
            "tests",
            ".github",
            ".env*",
            "auth.json",
            "builds",
            "box.phar",
            ".phpunit*",
            "phpunit.xml*",
            ".phpstan*"
        ]
    }
}
